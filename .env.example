# .env.example
# ?????? LLM (Groq ??? OpenAI-compatible endpoint) ??????
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_API_URL=//api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=20

# ?????? App ??????
HOSPITAL_NAME=City General Hospital
DATABASE_PATH=smart_queue.db
DEFAULT_CONSULT_MINUTES=12
NOTIFY_LEAD_MINUTES=30

# ?????? Simulator (turn OFF when you plug in a real hospital feed) ??????
AUTO_SIMULATE=true
SIMULATE_INTERVAL=25

# ?????? Delivery: "console" logs to terminal, "twilio" sends for real ??????
SMS_PROVIDER=console
